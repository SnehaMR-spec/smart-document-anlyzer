server {
    listen 80;
    client_max_body_size 1000M;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://backend:8000/;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
